<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="#070B1C"
                android:centerColor="#101A44"
                android:endColor="#2A1250"
                android:type="linear" />
        </shape>
    </item>
    <!--
        Логотип — векторная иконка. Тег <bitmap> принимает только растр
        (иначе BitmapDrawable падает с "requires a valid 'src' attribute"),
        поэтому подключаем вектор как обычный слой.
    -->
    <item
        android:drawable="@drawable/ic_logo"
        android:gravity="center"
        android:width="128dp"
        android:height="128dp" />
</layer-list>
